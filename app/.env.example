# Copy to .env.local for `npm run dev`, or set in the environment for `npm run build`.
# The network pools and snapshots name: sol-devnet or sol.
VITE_NETWORK=sol-devnet
# A Solana RPC for that network.
VITE_RPC_URL=https://api.devnet.solana.com
# Where the pools' signer serves snapshots with their proofs, and loan vault thaws.
VITE_SNAPSHOT_API_URL=https://api.scriply.io
